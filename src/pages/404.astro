---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Lost in the stacks — Fiction & Fact Library">
  <section class="hero wrap">
    <p class="eyebrow">Error 404</p>
    <h1>Lost in the <em>stacks</em>.</h1>
    <p class="hero__lead">
      This page has been misfiled. Perhaps it was checked out long ago and never returned.
    </p>
    <div class="ornament"><span>❧</span></div>
    <p class="center" style="margin-top: 18px;">
      <a class="btn" href={import.meta.env.BASE_URL}>Back to the library →</a>
    </p>
  </section>
</Layout>
